{
  "name": "partdrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Drop a CAD file, get a machine-time quote in seconds, pay with PayPal. Money moves to the shop only when the part passes inspection.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/copy-occt.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bryntum/gantt": "npm:@bryntum/gantt-trial@^7.3.7",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "express": "^5.2.1",
    "occt-import-js": "^0.0.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
