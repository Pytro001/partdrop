# Amazon Bedrock (Converse API, bearer token)
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=us-east-1
BEDROCK_CLAUDE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# AI_MODE: live (default) | record | replay   (replay serves server/cassettes, used for the film)
AI_MODE=live

# PayPal: mock (local fake of the REST API, default) | sandbox (needs the three values below)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# optional: a vaulted PayPal wallet id for the buyer agent in sandbox mode
PAYPAL_VAULT_ID=
# offline (default, verifies SHA256withRSA locally) | postback (calls verify-webhook-signature)
PAYPAL_WEBHOOK_VERIFY=offline

PORT=8306
# the public URL of this API (the mock PayPal links and webhooks point here)
PUBLIC_API_URL=http://localhost:8306
CORS_ORIGINS=http://localhost:5306
AUTH_SECRET=change-me
DEMO_PASSWORD=partdrop
AGENT_MANDATE_USD=5000
# 1 = counter based ids so a recorded film run replays identically
DETERMINISTIC_IDS=0
